# Secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# Local database, encryption key and saved credentials
.local/
*.sqlite
*.sqlite3
*.db

# Installed packages and build output (recreated by npm ci / npm run build)
node_modules/
dist/
worker/assets.generated.js
downloads/*.zip
configs/

# Logs, backups and temporary files
*.log
npm-debug.log*
*.bak
*.tmp
.cache/

# Editor and computer clutter
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
.claude/

# Vercel
.vercel/
