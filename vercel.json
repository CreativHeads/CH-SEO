{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/:path*/",
      "destination": "/api/index?__path=/:path*/"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__path=/:path*"
    }
  ]
}
