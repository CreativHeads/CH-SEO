{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "dist/server/**" }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__path=/:path*" }
  ]
}
